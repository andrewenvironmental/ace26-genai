# Local Azure deployment context. Keep real tenant, subscription, and resource names out of git.
.env
.env.*
!.env.example

# Local Bicep/Azure parameter files may contain tenant-specific values.
infra/**/*.parameters.json
!infra/**/*.parameters.example.json
infra/**/*.bicepparam
!infra/**/*.example.bicepparam
infra/**/*.local.json
infra/**/*.local.bicepparam
infra/**/local.*

# Azure CLI / deployment outputs
.azure/
.tmp/
.azure/**/*.local.*
.azure/**/outputs*.json
.azure/**/what-if*.json
infra/main.json
infra/resource-group.json

# Extracted Office document scratch files
.azure/docx-extract/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
*.code-workspace
docs/old/
plan/
docs/instructor-notes.md
docs/colab-fallback.md
docs/azure-config-discovery.md
